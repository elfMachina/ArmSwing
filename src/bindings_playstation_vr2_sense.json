{
    "bindings": {
        "/actions/armswing": {
            "sources": [
                {
                    "path": "/user/hand/left/input/left_stick",
                    "mode": "joystick",
                    "inputs": {
                        "position": {
                            "output": "/actions/armswing/in/left_stick_pos"
                        }
                    }
                },
                {
                    "path": "/user/hand/left/input/l1",
                    "mode": "button",
                    "inputs": {
                        "click": {
                            "output": "/actions/armswing/in/left_hand_use"
                        }
                    }
                },
                {
                    "path": "/user/hand/left/input/l2",
                    "mode": "trigger",
                    "inputs": {
                        "click": {
                            "output": "/actions/armswing/in/left_hand_use"
                        }
                    }
                },
                {
                    "path": "/user/hand/right/input/r1",
                    "mode": "button",
                    "inputs": {
                        "click": {
                            "output": "/actions/armswing/in/right_hand_use"
                        }
                    }
                },
                {
                    "path": "/user/hand/right/input/r2",
                    "mode": "trigger",
                    "inputs": {
                        "click": {
                            "output": "/actions/armswing/in/right_hand_use"
                        }
                    }
                },
                {
                    "path": "/user/hand/left/input/l1_sensor",
                    "mode": "button",
                    "inputs": {
                        "click": {
                            "output": "/actions/armswing/in/left_hand_sensor"
                        }
                    }
                },
                {
                    "path": "/user/hand/left/input/l2_sensor",
                    "mode": "button",
                    "inputs": {
                        "click": {
                            "output": "/actions/armswing/in/left_hand_sensor"
                        }
                    }
                },
                {
                    "path": "/user/hand/right/input/r1_sensor",
                    "mode": "button",
                    "inputs": {
                        "click": {
                            "output": "/actions/armswing/in/right_hand_sensor"
                        }
                    }
                },
                {
                    "path": "/user/hand/right/input/r2_sensor",
                    "mode": "button",
                    "inputs": {
                        "click": {
                            "output": "/actions/armswing/in/right_hand_sensor"
                        }
                    }
                }
            ]
        }
    },
    "controller_type": "playstation_vr2_sense",
    "description": "armswing PSVR2 Sense \u2014 left stick position + hand poses"
}